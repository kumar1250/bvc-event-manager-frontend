# Single backend:
VITE_API_BASE_URL=http://localhost:8000/api/v2

# Multiple backends with automatic failover (tried left to right), e.g. two
# Render instances of the same Django app. Overrides VITE_API_BASE_URL above
# if set.
# VITE_API_BASE_URLS=https://main-server.onrender.com/api/v2,https://backup-server.onrender.com/api/v2
